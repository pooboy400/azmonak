// ============================================================
// آزمونک — Schema v1
// مبنای طراحی:
//   - گام ۰٫۳ سند برنامه توسعه v1.3: جدول‌های سند (users, questions,
//     misconceptions, question_misconception, attempts, ability_state,
//     review_schedule, misconception_state) + identity/otp_codes (G10)
//     + status روی questions (G6) + params_snapshot روی attempts (G7)
//     + نردبان سطح دسته‌ای D16 (سطح ۱–۳، استریک‌ها، شمارنده ضعف)
//   - افزونه‌های سند طراحی فرانت v2.1: subjects/topics (درس‌محور)،
//     sessions (لیدربرد هفتگی = میانگین نمره وزن‌دار D13)، friendships/
//     classes (کامیونیتی)، privacy روی users (G10 رابط)
// قواعد:
//   - SQLite از enum پشتیبانی نمی‌کند؛ مقادیر مجاز به‌صورت String با
//     مقادیر ثابت مستندشده زیر هر فیلد کنترل می‌شوند (کد انگلیسی — D5).
//   - «داده نمونه»: هر رکورد بذری isSample=true و شناسه با پیشوند smp
//     دارد و با `bun run db:clean-sample` کامل حذف می‌شود.
//   - مجاز مقادیر:
//     role        : STUDENT | TEACHER | ADMIN
//     grade       : GRADE10 | GRADE11 | GRADE12
//     major       : EXPERIMENTAL | MATH | HUMANITIES
//     privacy     : PUBLIC | FRIENDS | PRIVATE   (پیش‌فرض FRIENDS)
//     q.status    : DRAFT | IN_REVIEW | APPROVED | RETIRED   (G6)
//     difficulty  : EASY | MEDIUM | HARD  → ۱۱۵۰ / ۱۲۵۰ / ۱۳۵۰
//     confidence  : CONFIDENT | GUESSED               (D14)
//     session.type: PLACEMENT | PRACTICE | REVIEW     (D1 + مرور فاصله‌دار SM-2)
//     session.status: ACTIVE | COMPLETED | ABANDONED
//     f.status    : PENDING | ACCEPTED
//     forum.status: OPEN | RESOLVED
//     vote target: ForumQuestionVote / ForumAnswerVote (مدل جدا برای هر هدف — SQLite پسندیده)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------- هویت (G10 — جدا از داده پژوهشی) ----------------

model User {
  id          String   @id @default(cuid())
  role        String   @default("STUDENT") // STUDENT | TEACHER | ADMIN
  username    String?  @unique // آیدی یکتا تلگرام‌مانند (a-z + 0-9 + _ ، ۴ تا ۲۴ نویسه) — برای جست‌وجوی افراد؛ null یعنی هنوز انتخاب نشده (آنبوردینگ اجباری)
  nickname    String // نام نمایشی/لقب — یکتا نیست (مثل تلگرام)؛ آیدی هویت یکتاست نه لقب
  avatarUrl   String? // آواتار آپلودی کاربر (تصمیم جدید — عکس پروفایل، نه استیکر/ایموجی)؛ خالی = placeholder پیش‌فرض در UI
  grade       String? // GRADE10 | GRADE11 | GRADE12 — فقط دانش‌آموز
  major       String? // EXPERIMENTAL | MATH | HUMANITIES — فقط دانش‌آموز
  privacy     String   @default("FRIENDS") // PUBLIC | FRIENDS | PRIVATE
  isActive    Boolean  @default(true)
  isSample    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  identity             Identity?
  sessions             Session[]
  attempts             Attempt[]
  subjectAbilities     SubjectAbility[]
  topicAbilities       TopicAbility[]
  reviewSchedules      ReviewSchedule[]
  misconceptionStates  MisconceptionState[]
  classesOwned         ClassRoom[]          @relation("ClassTeacher")
  classMemberships     ClassMember[]
  friendshipsRequested Friendship[]         @relation("FriendshipRequester")
  friendshipsReceived  Friendship[]         @relation("FriendshipAddressee")
  forumQuestions        ForumQuestion[]        @relation("ForumQuestions")
  forumAnswers          ForumAnswer[]          @relation("ForumAnswers")
  forumQuestionVotes    ForumQuestionVote[]    @relation("ForumQuestionVotes")
  forumAnswerVotes      ForumAnswerVote[]      @relation("ForumAnswerVotes")
  assignmentCompletions AssignmentCompletion[] @relation("AssignmentCompletions")

  @@index([role, grade, major])
  @@index([isSample])
  @@map("users")
}

model Identity {
  id         String    @id @default(cuid())
  userId     String    @unique
  phone      String    @unique // یک شماره فعال به‌ازای هر کاربر (G10)
  isActive   Boolean   @default(true)
  verifiedAt DateTime?
  isSample   Boolean   @default(false)
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phone])
  @@map("identity")
}

model OtpCode {
  id           String    @id @default(cuid())
  phone        String
  code         String // کد ۵ رقمی (D3)
  expiresAt    DateTime // انقضای ۲ دقیقه
  attemptCount Int       @default(0) // حداکثر ۵ تلاش
  consumedAt   DateTime?
  isSample     Boolean   @default(false)
  createdAt    DateTime  @default(now())

  @@index([phone, expiresAt])
  @@map("otp_codes")
}

// ---------------- محتوا (درس → مبحث → سؤال) ----------------

model Subject {
  id        String   @id @default(cuid())
  code      String   @unique // مثل FAR12G
  title     String // مثل «فارسی ۳» — پسوند عددی باید با پایه بخواند: ۱=دهم، ۲=یازدهم، ۳=دوازدهم
  grade     String // GRADE10 | GRADE11 | GRADE12
  major     String? // null = درس عمومی (همهٔ رشته‌ها) | "EXPERIMENTAL" | "MATH" | "HUMANITIES" | مشترک با ویرگول مثل "MATH,EXPERIMENTAL"
  iconKey   String? // نام آیکون lucide (سند طراحی — فصل آیکون‌ها)
  colorKey  String? // کلید رنگ توکن (سند طراحی — پالت)
  isActive  Boolean  @default(true)
  isSample  Boolean  @default(false)
  createdAt DateTime @default(now())

  topics           Topic[]
  questions        Question[]
  sessions         Session[]
  subjectAbilities SubjectAbility[]
  topicAbilities   TopicAbility[]
  reviewSchedules  ReviewSchedule[]
  forumQuestions   ForumQuestion[]
  assignments      Assignment[]

  @@unique([grade, major, title])
  @@index([grade, major, isActive])
  @@map("subjects")
}

model Topic {
  id        String   @id @default(cuid())
  subjectId String
  title     String // «دسته» همان فیلد topic سند
  order     Int      @default(0)
  isSample  Boolean  @default(false)

  subject         Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  questions       Question[]
  topicAbilities  TopicAbility[]
  reviewSchedules ReviewSchedule[]
  forumQuestions  ForumQuestion[]

  @@unique([subjectId, title])
  @@map("topics")
}

model Question {
  id             String   @id @default(cuid())
  qid            String   @unique // مثل SMP-FAR11T-01 — یکتا، ثابت، هرگز بازیافت نمی‌شود (G11)
  subjectId      String
  topicId        String?
  status         String   @default("DRAFT") // DRAFT | IN_REVIEW | APPROVED | RETIRED (G6)
  author         String // الزامی — ثبت منشأ برای مجوز
  difficulty     String // EASY | MEDIUM | HARD
  stem           String // صورت سؤال؛ فرمول‌ها با $LaTeX$
  optionA        String
  optionB        String
  optionC        String
  optionD        String
  correct        String // A | B | C | D
  distractorMap  String   @default("-") // مثل "a:M03; c:M01" — اختیاری (D16)
  explanation    String // پاسخ تشریحی — حداقل دو جمله
  estTimeSec     Int      @default(90) // مبنای آستانه تأخیر اختصاصی (G4)
  license        String   @default("CC BY-NC 4.0")
  notes          String?
  rating         Float    @default(1250) // سختی Elo: EASY ۱۱۵۰ / MEDIUM ۱۲۵۰ / HARD ۱۳۵۰
  ratingCount    Int      @default(0) // K_q پس از ۴۰ پاسخ ۴ می‌شود
  isSample       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subject    Subject                 @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topic      Topic?                  @relation(fields: [topicId], references: [id], onDelete: SetNull)
  attempts   Attempt[]
  misLinks   QuestionMisconception[]

  @@index([subjectId, status])
  @@index([topicId, difficulty])
  @@index([status, difficulty])
  @@index([isSample])
  @@map("questions")
}

// ---------------- پژوهشی: جلسه و پاسخ ----------------

model Session {
  id            String    @id @default(cuid())
  userId        String
  subjectId     String
  type          String    @default("PRACTICE") // PLACEMENT (۴ سؤالی — D1) | PRACTICE (۱۰ سؤالی — D12) | REVIEW (صف مرور SM-2)
  status        String    @default("ACTIVE") // ACTIVE | COMPLETED | ABANDONED
  questionCount Int       @default(10)
  correctCount  Int       @default(0)
  score         Float? // نمره وزن‌دار D13 (۰–۱۰۰) — پس از اتمام
  rStart        Float     @default(1100) // توان R_s پیش از جلسه
  rEnd          Float? // توان R_s پس از جلسه (نمودار دولایه D15)
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  lastActivityAt DateTime? // برای ازسرگیری جلسه نیمه‌کاره
  isSample      Boolean   @default(false)
  createdAt     DateTime  @default(now())

  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  attempts Attempt[]
  assignmentId String? // اگر جلسه برای یک تمرین کلاسی شروع شده باشد
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  @@index([userId, startedAt])
  @@index([subjectId, status, startedAt])
  @@index([userId, subjectId, type])
  @@index([isSample])
  @@map("sessions")
}

model Attempt {
  id             String   @id @default(cuid())
  sessionId      String
  userId         String
  questionId     String
  orderInSession Int      @default(0) // ۱ تا ۱۰
  selected       String // A | B | C | D
  isCorrect      Boolean
  confidence     String // CONFIDENT | GUESSED (D14 — پس از انتخاب، پیش از بازخورد)
  latencySec     Float    @default(0) // t_fast=۱۵s / t_slow=۷۰s (D10)
  weight         Float    @default(1) // وزن D13: آسان ۱ / متوسط ۱٫۵ / سخت ۲
  rBefore        Float    @default(1100)
  rAfter         Float    @default(1100)
  paramsSnapshot String? // snapshot پارامترهای الگوریتم در لحظه پاسخ (G7)
  isSample       Boolean  @default(false)
  createdAt      DateTime @default(now()) // لحظه پاسخ

  session  Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([userId, questionId])
  @@index([userId, createdAt])
  @@index([questionId, createdAt])
  @@index([isSample])
  @@map("attempts")
}

// ---------------- توان و نردبان سطح (D16) ----------------

// توان سراسری هر (دانش‌آموز، درس) — همان ردیف GLOBAL
model SubjectAbility {
  id            String   @id @default(cuid())
  userId        String
  subjectId     String
  rating        Float    @default(1100) // R_s
  answeredCount Int      @default(0) // برنامه K: ۳۲ ← ۲۴ (پس از ۵۰) ← ۱۶ (پس از ۱۵۰)
  isSample      Boolean  @default(false)
  updatedAt     DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([userId, subjectId])
  @@map("ability_state_subject")
}

// ردیف دسته‌محور نردبان سطح — به‌ازای هر (دانش‌آموز، مبحث): سطح ۱–۳ + استریک‌ها
model TopicAbility {
  id            String   @id @default(cuid())
  userId        String
  subjectId     String // نرمال‌سازی‌شده برای کوئری‌های داشبورد
  topicId       String
  level         Int      @default(2) // ۱–۳ (۱۱۵۰/۱۲۵۰/۱۳۵۰) — نوار سختی انتخاب
  wrongStreak   Int      @default(0) // n=۲ غلط پیاپی ← افت سطح
  rightStreak   Int      @default(0) // m=۲ درست پیاپی ← ارتقا (حداکثر ۱ در جلسه)
  weaknessCount Int      @default(0) // شمارنده ضعف در کف سطح ۱
  answeredCount Int      @default(0) // مبنای هشدار مطالعه: <۳۰٪ در ۵ پاسخ آخر
  isSample      Boolean  @default(false)
  updatedAt     DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topic   Topic   @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([subjectId, level])
  @@map("ability_state_topic")
}

// ---------------- مرور فاصله‌دار SM-2 ----------------

model ReviewSchedule {
  id             String    @id @default(cuid())
  userId         String
  subjectId      String
  topicId        String
  ef             Float     @default(2.5) // کف ۱٫۳
  intervalDays   Int       @default(0) // I(1)=1, I(2)=6, I(n)=ceil(I(n-1)×EF)
  repetitions    Int       @default(0)
  dueAt          DateTime // صف «مرور امروز»
  lastReviewedAt DateTime?
  isSample       Boolean   @default(false)
  updatedAt      DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topic   Topic   @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([dueAt])
  @@map("review_schedule")
}

// ---------------- بدفهمی (پارک‌شده با D16 — اسکیما حفظ شده) ----------------

model Misconception {
  code            String   @id // M01 … M10
  title           String // «مشتق را تفاضل می‌فهمد نه نرخ لحظه‌ای»
  behaviorSign    String // نشانه رفتاری در پاسخ‌ها
  prerequisites   String   @default("") // کدها جدا با ; (گراف)
  remedialTopic   String? // موضوع سؤال اصلاحی هدفمند
  explanationText String   @default("") // متن آموزشی پس از تثبیت
  isSample        Boolean  @default(false)
  createdAt       DateTime @default(now())

  misLinks QuestionMisconception[]
  states   MisconceptionState[]

  @@map("misconceptions")
}

model QuestionMisconception {
  id                String  @id @default(cuid())
  questionId        String
  option            String // A | B | C | D — گزینه فریبنده
  misconceptionCode String
  isSample          Boolean @default(false)

  question      Question      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  misconception Misconception @relation(fields: [misconceptionCode], references: [code], onDelete: Cascade)

  @@unique([questionId, option])
  @@map("question_misconception")
}

model MisconceptionState {
  id                String    @id @default(cuid())
  userId            String
  misconceptionCode String
  witnessCount      Int       @default(0) // قاعده دو شاهد (D12): دو جلسه ≥ ۲ ساعت فاصله
  witnesses         String    @default("[]") // JSON: [{attemptId, seenAt}]
  confirmedAt       DateTime?
  isSample          Boolean   @default(false)
  updatedAt         DateTime  @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  misconception Misconception @relation(fields: [misconceptionCode], references: [code], onDelete: Cascade)

  @@unique([userId, misconceptionCode])
  @@map("misconception_state")
}

// ---------------- کامیونیتی (سند طراحی فرانت v2.1) ----------------

model Friendship {
  id          String    @id @default(cuid())
  requesterId String
  addresseeId String
  status      String    @default("PENDING") // PENDING | ACCEPTED
  createdAt   DateTime  @default(now())
  respondedAt DateTime?
  isSample    Boolean   @default(false)

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@map("friendships")
}

model ClassRoom {
  id        String   @id @default(cuid())
  name      String // «یازدهم تجربی ۱»
  code      String   @unique // کد پیوستن کلاس
  teacherId String
  grade     String
  major     String
  isSample  Boolean  @default(false)
  createdAt DateTime @default(now())

  teacher User           @relation("ClassTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  members ClassMember[]
  assignments Assignment[]

  @@index([grade, major])
  @@map("classes")
}

// ---------------- تمرین کلاسی (پنل معلم) ----------------

// معلم برای کلاسش یک تمرین (درس + تعداد سؤال + مهلت اختیاری) می‌سازد؛
// دانش‌آموز از داشبورد شروع می‌کند و با اتمام جلسه، تکمیل تمرین ثبت می‌شود.
model Assignment {
  id            String    @id @default(cuid())
  classId       String
  subjectId     String
  title         String // «تمرین هفتهٔ ۶ — مشتق»
  questionCount Int       @default(10) // ۴ تا ۲۰
  dueAt         DateTime? // مهلت اختیاری
  isSample      Boolean   @default(false)
  createdAt     DateTime  @default(now())

  class       ClassRoom              @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject     Subject                @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  completions AssignmentCompletion[]
  sessions    Session[]

  @@index([classId, createdAt])
  @@index([subjectId])
  @@map("assignments")
}

model AssignmentCompletion {
  id           String   @id @default(cuid())
  assignmentId String
  studentId    String
  sessionId    String? // جلسه‌ای که تمرین با آن کامل شد
  score        Float? // نمرهٔ همان جلسه (۰–۱۰۰)
  completedAt  DateTime @default(now())
  isSample     Boolean  @default(false)

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User       @relation("AssignmentCompletions", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([studentId])
  @@map("assignment_completions")
}

// ---------------- انجمن پرسش و پاسخ ----------------
// بدنهٔ سؤال/پاسخ فرمول LaTeX ($...$ / $$...$$) را پشتیبانی می‌کند و
// فقط با کامپوننت MathText رندر می‌شود (قاعدهٔ فاز فرمول‌ها).

model ForumQuestion {
  id        String   @id @default(cuid())
  authorId  String
  subjectId String
  topicId   String?
  title     String // ۵ تا ۱۲۰ نویسه
  body      String // تا ۴۰۰۰ نویسه — با $LaTeX$
  status    String   @default("OPEN") // OPEN | RESOLVED — با پذیرش پاسخ RESOLVED می‌شود
  viewCount Int      @default(0)
  isSample  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author  User    @relation("ForumQuestions", fields: [authorId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topic   Topic?  @relation(fields: [topicId], references: [id], onDelete: SetNull)
  answers ForumAnswer[]
  votes   ForumQuestionVote[]

  @@index([subjectId, status, createdAt])
  @@index([authorId, createdAt])
  @@map("forum_questions")
}

model ForumAnswer {
  id         String   @id @default(cuid())
  questionId String
  authorId   String
  body       String // تا ۴۰۰۰ نویسه — با $LaTeX$
  isAccepted Boolean  @default(false) // پذیرش توسط نویسندهٔ سؤال یا ادمین
  isSample   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  question ForumQuestion     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  author   User              @relation("ForumAnswers", fields: [authorId], references: [id], onDelete: Cascade)
  votes    ForumAnswerVote[]

  @@index([questionId, createdAt])
  @@index([authorId])
  @@map("forum_answers")
}

model ForumQuestionVote {
  id         String   @id @default(cuid())
  questionId String
  userId     String
  createdAt  DateTime @default(now())
  isSample   Boolean  @default(false)

  question ForumQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     User          @relation("ForumQuestionVotes", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([questionId, userId])
  @@map("forum_question_votes")
}

model ForumAnswerVote {
  id        String   @id @default(cuid())
  answerId  String
  userId    String
  createdAt DateTime @default(now())
  isSample  Boolean  @default(false)

  answer ForumAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  user   User        @relation("ForumAnswerVotes", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([answerId, userId])
  @@map("forum_answer_votes")
}

model ClassMember {
  id        String   @id @default(cuid())
  classId   String
  studentId String
  joinedAt  DateTime @default(now())
  isSample  Boolean  @default(false)

  class   ClassRoom @relation(fields: [classId], references: [id], onDelete: Cascade)
  student User      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classId, studentId])
  @@map("class_members")
}

// ---------------- سایت عمومی (CMS سبک — هیچ محتوایی هاردکد نیست) ----------------
// قاعده نمونه: رکوردهای بذری isSample=true و با db:clean-sample حذف می‌شوند؛
// پیام‌های تماس داده واقعی کاربران‌اند و پرچم نمونه ندارند.

model SiteSetting {
  key       String   @id // مثل site.name / hero.title / features (JSON)
  value     String // متن ساده یا JSON
  isSample  Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

model Faq {
  id       String  @id @default(cuid())
  question String
  answer   String
  order    Int     @default(0)
  isActive Boolean @default(true)
  isSample Boolean @default(false)

  @@index([isActive, order])
  @@map("faqs")
}

model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String
  content     String // Markdown
  coverIcon   String   @default("newspaper") // نام آیکون lucide (icon-map)
  coverTone   String   @default("violet") // violet | orange | teal | rose | sky
  authorName  String
  isPublished Boolean  @default(true)
  publishedAt DateTime @default(now())
  isSample    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, publishedAt])
  @@map("blog_posts")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  contact   String // ایمیل یا شماره تماس فرستنده
  body      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("contact_messages")
}
